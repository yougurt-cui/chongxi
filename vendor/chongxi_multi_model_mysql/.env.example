# 配置可写入项目根目录 .env，或本模块 .env；环境变量优先。
# 千问复用 app_config（含 DASHSCOPE_API_KEY、QWEN_API_KEY 和 YAML 配置）。
# 豆包密钥可复用已有 ARK_API_KEY / VOLCENGINE_ARK_API_KEY。
# 不要把空的密钥占位符覆盖到已有配置。
# DOUBAO_API_KEY=你的豆包密钥（已有 ARK_API_KEY 时无需重复）
DOUBAO_MODEL=
# DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# DEEPSEEK_API_KEY=你的 DeepSeek 密钥
# DEEPSEEK_MODEL=你已开通的模型名称

# 默认复用项目 MySQL 数据库；可指定已存在的独立库。
# MULTI_MODEL_MYSQL_DATABASE=chongxi_knowledge
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
