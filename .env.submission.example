# Merge these keys into the existing backend .env; never overwrite database,
# model or session credentials. This file contains no real secrets.

# 18: Set to 1 only on the designated backend application instance.
CHONGXI_PIPELINE_WORKER=0
CHONGXI_PIPELINE_CONCURRENCY=1
CHONGXI_PIPELINE_SWEEP_SECONDS=60

# 19: Use the same WeChat mini-program as project.config.json.
# Reuse existing values if already configured; do not reset AppSecret.
WECHAT_MINIPROGRAM_APPID=wxec9a56b911900aa0
WECHAT_MINIPROGRAM_APP_SECRET=
WECHAT_FOOD_RESULT_TEMPLATE_ID=

# Fill the actual field keys of YOUR template. Example only:
# WECHAT_FOOD_RESULT_TEMPLATE_FIELDS='{"thing1":"product","phrase2":"status","time3":"completed_at"}'
# Selected AI analysis template (74906) uses thing1/thing3/time4:
# WECHAT_FOOD_RESULT_TEMPLATE_FIELDS='{"thing1":"analysis_type","thing3":"result_summary","time4":"completed_at"}'
WECHAT_FOOD_RESULT_TEMPLATE_FIELDS=

# trial = experience build; formal = published build; developer = development.
# This controls the notice destination, not a separate backend or task queue.
WECHAT_MINIPROGRAM_STATE=trial
